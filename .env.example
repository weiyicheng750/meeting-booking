# ============================================================
# 会议室预约系统 · 后端环境变量示例
# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 排除）
# ============================================================

# PostgreSQL 连接串（必填）
# 两种免费方案任选其一（拿连接串的步骤见 README）：

# --- 方案 A：Supabase 免费 PG（推荐，5 分钟搞定）---
# Supabase 控制台 → Settings → Database → Connection string → URI
# 形如：postgresql://postgres.[项目ID]:[密码]@aws-0-xxx.pooler.supabase.com:6543/postgres
# （SSL 自动识别，无需手动加 sslmode）
DATABASE_URL=

# --- 方案 B：CloudBase PG（需开「公网访问」，体验版可能不可用）---
# 形如：postgresql://cloudbase_postgres_pgdb_xxx:密码@内网或公网IP:5432/pgdb-xxx

# 后台密码（可选；留空用默认 appleipad2）
ADMIN_PASS=

# 服务端口（Render 自动注入，可不填）
# PORT=3000
